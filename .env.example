# ============================================================
# AgentHub 环境变量配置
# 复制此文件为 .env 并根据实际环境修改
# ============================================================

# ==================== 数据库 ====================
# PostgreSQL 连接字符串
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agenthub
# PostgreSQL 密码（Docker Compose 使用，与 DATABASE_URL 中的密码保持一致）
# POSTGRES_PASSWORD=postgres

# ==================== 向量数据库 ====================
# Qdrant 地址
QDRANT_URL=http://localhost:6333
# Qdrant API 密钥（本地开发可留空）
QDRANT_API_KEY=

# ==================== 认证 ====================
# JWT 签名密钥（⚠️ 生产环境必须修改为强随机字符串）
# 建议使用: openssl rand -base64 64
JWT_SECRET=change-me-in-production
# JWT 过期时间（默认 7 天）
# JWT_EXPIRES_IN=7d

# ==================== Redis ====================
# Redis 连接地址（可选，缺失时自动降级到内存模式）
# 限流和浏览计数缓冲依赖 Redis
REDIS_URL=redis://localhost:6379

# ==================== API 服务 ====================
API_PORT=3001
API_HOST=localhost

# ==================== Next.js 前端 ====================
NEXT_PUBLIC_API_URL=http://localhost:3001

# ==================== 运行环境 ====================
NODE_ENV=development

# ==================== CORS ====================
CORS_ORIGIN=http://localhost:3000

# ==================== 运维 ====================
# 优雅关闭超时（毫秒）
SHUTDOWN_TIMEOUT_MS=15000
# 日志级别: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
